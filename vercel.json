{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "refrigeracao-site-react.vercel.app"
        }
      ],
      "destination": "https://www.refrigerationcompany.com.br/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "refrigeracao-site-react.vercel.app"
        }
      ],
      "destination": "https://www.refrigerationcompany.com.br/:path*",
      "permanent": true
    }
  ]
}
